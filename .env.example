# Generate independent long random tokens. Do not commit .env.
API_TOKEN=replace-with-a-random-token-at-least-24-characters
AGENT_TOKEN=replace-with-a-different-long-random-token
POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-password
STORAGE_ROOT=./data
BIND_ADDRESS=127.0.0.1
PORT=8080
# Set true when using an HTTPS reverse proxy.
COOKIE_SECURE=false
CODEX_VERSION=0.155.1
IMDB_TIMEOUT_SECONDS=25
# Combined slots across encoder, CRF, and general workers (1–64).
# Apply changes to both workers while idle; see ./start.sh --update-encoder.
WORKER_CAPACITY=8
# Optional TTG image-host token. Needed only when screenshot uploads are selected.
TU_TTG_TOKEN=

# Replaced mux/release outputs expire after this many days; 0 keeps backups.
OUTPUT_BACKUP_DAYS=3
